# Chép thành .env rồi điền:  cp .env.example .env   (.env đã được git bỏ qua, không commit)

# Địa chỉ website như người xem gõ (có https://, không có / ở cuối).
SITE_URL=https://quyethue.vn

# Cổng container WordPress mở trên EC2 để proxy trỏ vào. Chọn cổng chưa bị dùng (kiểm tra: sudo ss -ltnp | grep :8081).
# WP_BIND=127.0.0.1: chỉ proxy trên chính máy này (nginx...) vào được.
# Proxy ở máy khác (vd Load Balancer) thì đặt WP_BIND=0.0.0.0 và giới hạn bằng Security Group.
WP_PORT=8081
WP_BIND=127.0.0.1

# Mật khẩu database: chuỗi dài ngẫu nhiên, tạo bằng lệnh  openssl rand -hex 24
# Chỉ có tác dụng ở lần chạy đầu (khi database được tạo). Đổi sau đó sẽ không còn khớp.
DB_PASSWORD=
DB_ROOT_PASSWORD=
